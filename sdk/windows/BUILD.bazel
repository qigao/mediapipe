load("@rules_cc//cc:cc_test.bzl", "cc_test")

[
    platform(
        name = "windows_" + arch,
        constraint_values = ["@platforms//os:windows", "@platforms//cpu:" + cpu],
    )
    for arch, cpu in [("x64", "x86_64"), ("arm64", "aarch64")]
]

cc_test(
    name = "threads_lifecycle_test",
    srcs = ["threads_lifecycle_test.cc"],
    local_defines = ["SALTS_API="],
    deps = ["@qigao_salts_threads//:threads"],
)
