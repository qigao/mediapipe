load("@rules_cc//cc:cc_toolchain.bzl", "cc_toolchain")
load(":mingw.bzl", "mingw_config")

package(default_visibility = ["//visibility:public"])
filegroup(name = "empty")

[
    platform(
        name = "windows_" + arch,
        constraint_values = ["@platforms//os:windows", "@platforms//cpu:" + cpu],
    )
    for arch, cpu in [("x64", "x86_64"), ("arm64", "aarch64")]
]

[
    mingw_config(name = "config_" + arch, arch = arch)
    for arch in ["x64", "arm64"]
]

[
    cc_toolchain(
        name = "cc_" + arch,
        toolchain_identifier = "llvm-mingw-" + arch,
        toolchain_config = ":config_" + arch,
        all_files = ":empty",
        ar_files = ":empty",
        as_files = ":empty",
        compiler_files = ":empty",
        dwp_files = ":empty",
        linker_files = ":empty",
        objcopy_files = ":empty",
        strip_files = ":empty",
        supports_param_files = 1,
    )
    for arch in ["x64", "arm64"]
]

[
    toolchain(
        name = "toolchain_" + arch,
        toolchain = ":cc_" + arch,
        toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
        exec_compatible_with = ["@platforms//os:windows"],
        target_compatible_with = ["@platforms//os:windows", "@platforms//cpu:" + cpu],
    )
    for arch, cpu in [("x64", "x86_64"), ("arm64", "aarch64")]
]
