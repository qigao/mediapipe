+#ifdef _WIN32
+  call_once(&egl_release_key_once, MakeEglReleaseThreadKey);
+  ABSL_CHECK_EQ(tss_set(egl_release_thread_key,
+                        reinterpret_cast<void*>(0xDEADBEEF)), thrd_success);
+#else
   pthread_once(&egl_release_key_once, MakeEglReleaseThreadKey);
